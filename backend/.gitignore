# Composer's packages (composer install); the upload ships its own (build-dist.php)
/vendor/

# One installation's configuration: written by setup.php, never committed
/config/*.local.php

# What the running app writes (the folders themselves are kept by their .gitignore files)
/storage/*
!/storage/.gitignore
!/storage/cache/
!/storage/http-cache/
!/storage/icons/
!/storage/logs/

# Editors and tools
.phpunit.result.cache
/.idea
/.vscode
*.log
