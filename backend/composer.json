{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "anotoki/build-analyzer",
    "type": "project",
    "description": "The build analyzer's API: game account imports, recommended builds and the analysis, on Slim 4 and PostgreSQL.",
    "keywords": [
        "genshin-impact",
        "honkai-star-rail",
        "builds",
        "slim"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "anotoki/lib": "^0.5.0",
        "composer/ca-bundle": "^1.5",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "voku/portable-ascii": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8400 router.php"
        ]
    },
    "scripts-descriptions": {
        "start": "The API and setup.php on http://localhost:8400: PHP's built-in server, with router.php"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/irelevant25/anotoki-lib"
        }
    ]
}
