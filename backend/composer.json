{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "anotoki/build-analyzer",
  "type": "project",
  "description": "The build analyzer's API: game account imports, recommended builds and the analysis, on Slim 4 and PostgreSQL.",
  "keywords": [
    "genshin-impact",
    "honkai-star-rail",
    "builds",
    "slim"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "anotoki/lib": "^0.8.0",
    "composer/ca-bundle": "^1.5",
    "slim/psr7": "^1.8",
    "slim/slim": "^4.15",
    "voku/portable-ascii": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform-check": false
  },
  "extra": {
    "anotoki-deploy": {
      "site": "build-analyzer",
      "remote": "/anotoki.eu/sub/builder",
      "url": "https://builder.anotoki.eu",
      "frontendBuild": "npm run build && node ../backend/tools/check-release.mjs",
      "headers": {
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "noCache": [
        "changelog.json"
      ],
      "smoke": [
        "/api/site-status"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "php -S localhost:8400 router.php"
    ]
  },
  "scripts-descriptions": {
    "start": "The API and setup.php on http://localhost:8400: PHP's built-in server, with router.php"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/irelevant25/anotoki-lib"
    }
  ]
}
